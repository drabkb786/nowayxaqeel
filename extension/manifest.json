{
  "manifest_version": 3,
  "name": "ChatGPT Stripe UPI Pay Link",
  "description": "Create a Stripe checkout link from the signed-in ChatGPT session in this browser.",
  "version": "1.1.0",
  "permissions": [
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ],
  "action": {
    "default_title": "Get Stripe UPI Pay Link",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}

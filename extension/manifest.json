{
  "manifest_version": 3,
  "name": "Noway",
  "description": "Noway — generate a ChatGPT checkout link from your signed-in session. Created by Noway.",
  "version": "1.2.0",
  "permissions": [
    "clipboardWrite",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ],
  "action": {
    "default_title": "Noway",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
